# Keep Razorpay in test mode until Saanjh Beauty's Razorpay business verification is complete.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Local development
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data

# Admin HTTP Basic password. Choose a long, unique password; do not commit .env.
ADMIN_PASSWORD=replace_with_a_long_random_password

# Optional SMTP settings; configure these to send payment confirmations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Saanjh Beauty <orders@example.com>

# PostgreSQL deployment: set DATABASE_URL and optionally PGSSL=disable for local PG.
# DATABASE_URL=postgresql://user:password@host:5432/saanjh
